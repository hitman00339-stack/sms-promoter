<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F8FAFC">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📱 SMS Auto Promoter"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#0F172A" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Admin API URL:"
        android:layout_marginTop="12dp"
        android:textStyle="bold" />
    
    <EditText
        android:id="@+id/etApiUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="https://yourwebsite.com/api.php"
        android:inputType="textUri"
        android:text="https://yourwebsite.com/api.php" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select SIM Card:"
        android:layout_marginTop="12dp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerSim"
        android:layout_width="match_parent"
        android:layout_height="48dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delay Between SMS (seconds):"
        android:layout_marginTop="12dp"
        android:textStyle="bold" />

    <!-- Default set to 5 seconds -->
    <EditText
        android:id="@+id/etDelay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:text="5" />

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="🚀 FETCH &amp; START CAMPAIGN"
        android:backgroundTint="#2563EB"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Idle"
        android:textAlignment="center"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#166534"
        android:layout_marginTop="12dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0F172A"
        android:layout_marginTop="12dp"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#38BDF8"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:text="> App initialized. Default delay: 5s." />
    </ScrollView>
</LinearLayout>